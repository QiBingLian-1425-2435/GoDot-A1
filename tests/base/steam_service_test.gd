extends SceneTree
const Texts = preload("res://features/localization/game_text.gd")
const Service = preload("res://app/network/steam_service.gd")
const Session = preload("res://app/network/session.gd")
const FakeSteam = preload("res://tests/base/fake_steam.gd")
const FakePeer = preload("res://tests/base/fake_peer.gd")
const ROOM_A := 109775243000000001
const ROOM_B := 109775243000000002
var assertions := 0
var errors: Array[String] = []
func _initialize() -> void: call_deferred("run")
func check(ok:bool,message:String) -> void:
    assertions+=1
    if not ok:
        errors.append(message)
        print("FAIL: ",message)
func fixture(enforce:bool=true) -> Dictionary:
    var api=FakeSteam.new()
    api.enforce_owner_membership=enforce
    var svc=Service.new()
    svc.steam=api
    var peers:Array=[]
    svc.peer_factory=func():
        var p=FakePeer.new()
        peers.append(p)
        return p
    var signals={"transports":[],"failures":[],"joins":[],"overlays":[]}
    svc.transport_ready.connect(func(p,host):signals.transports.append([p,host]))
    svc.failed.connect(func(message):signals.failures.append(message))
    svc.join_requested.connect(func(id):signals.joins.append(id))
    svc.overlay_changed.connect(func(active):signals.overlays.append(active))
    root.add_child(svc)
    svc.set_process(false)
    return {"svc":svc,"api":api,"peers":peers,"signals":signals}
func dispose(f:Dictionary) -> void:
    if is_instance_valid(f.svc):f.svc.free()
func room(f:Dictionary,id:int=ROOM_A) -> void:
    f.api.populate(id,Service.GAME_KEY,Service.PROTOCOL)
func prepare_join(f:Dictionary,id:int=ROOM_A) -> void:
    room(f,id)
    f.svc.join_room(str(id))
    f.api.lobby_data_update.emit(1,id,id)
func run() -> void:
    test_initialization()
    test_codes()
    test_host()
    test_join()
    test_cancel_and_timeout()
    test_identity_and_health()
    test_social()
    test_session()
    test_extra_failures()
    test_cancelled_migration()
    print("STEAM_SERVICE_MOCK_TEST: ",assertions," assertions, ",errors.size()," failed")
    quit(0 if errors.is_empty() else 1)
func test_initialization() -> void:
    var f=fixture()
    f.api.init_status=2
    check(not f.svc.initialize(),"failed SDK init returns false")
    check(not f.svc.initialized and f.api.relay_calls==0,"failed SDK init cannot initialize relay")
    f.api.init_status=0
    check(f.svc.initialize(),"failed SDK init may be retried")
    check(f.api.init_calls==2 and f.api.relay_calls==1,"retry initializes SDK then relay once")
    f.svc.initialize()
    check(f.api.init_calls==2,"already initialized service reuses SDK")
    f.svc.leave_room()
    check(f.api.shutdown_calls==0,"leave never shuts SDK down")
    f.svc.free()
    check(f.api.shutdown_calls==1,"service teardown shuts SDK down exactly once")
    f=fixture()
    f.api.online=false
    check(not f.svc.initialize(),"offline Steam is unavailable even after SDK init")
    f.api.online=true
    check(f.svc.initialize() and f.api.init_calls==1,"online retry reuses initialized SDK")
    dispose(f)
func test_codes() -> void:
    check(Service.parse_lobby_code(str(ROOM_A))==ROOM_A,"valid 64 bit lobby ID is exact")
    check(Service.parse_lobby_code("  "+str(ROOM_A)+"  ")==ROOM_A,"room ID surrounding spaces accepted")
    for code in ["","0","-109775243000000001","109775243000000001x","0109775243000000001","9999999999999999999","1e18"]:
        check(Service.parse_lobby_code(code)==0,"invalid lobby ID rejected: "+code)
func test_host() -> void:
    var f=fixture()
    check(f.svc.host_room()==OK,"host creation starts")
    check(f.api.created==[[1,5]],"host uses five member friends only lobby")
    f.api.emit_created(ROOM_A)
    check(f.svc.lobby_id==ROOM_A and f.svc.host_steam_id==f.api.MY_ID,"host identity established")
    check(f.peers.size()==1 and f.peers[0].host_calls==1 and not f.peers[0].relay,"host starts one native peer without client relaying")
    check(f.signals.transports.size()==1 and f.signals.transports[0][1],"host publishes transport once")
    check(f.api.getLobbyData(ROOM_A,"game")==Service.GAME_KEY and f.api.getLobbyData(ROOM_A,"protocol")==Service.PROTOCOL,"host publishes game and protocol isolation")
    f.api.emit_joined(ROOM_A)
    f.api.emit_joined(ROOM_A)
    check(f.peers.size()==1 and f.signals.transports.size()==1,"duplicate own joined callbacks cannot create clients")
    f.svc.leave_room()
    check(f.peers[0].closed==1 and f.api.left.has(ROOM_A) and not f.api.joinable[ROOM_A],"host leave closes peer, closes lobby and exits")
    check(f.api.shutdown_calls==0 and f.svc.lobby_id==0,"host leave retains SDK and clears current room")
    check(f.svc.host_room()==OK,"host can recreate after normal leave")
    f.api.emit_created(ROOM_B)
    check(f.peers.size()==2,"recreate creates fresh peer")
    dispose(f)
    f=fixture()
    f.svc.host_room()
    f.api.emit_created(0,2)
    check(f.peers.is_empty() and f.signals.failures.size()==1,"failed create callback cannot start transport")
    check(f.svc.host_room()==OK,"failed create can retry")
    dispose(f)
    f=fixture()
    f.api.set_data_ok=false
    f.svc.host_room()
    f.api.emit_created(ROOM_A)
    check(f.svc.lobby_id==0 and f.api.left.has(ROOM_A) and f.peers.is_empty(),"metadata write failure leaves created lobby")
    dispose(f)
func test_join() -> void:
    var f=fixture()
    prepare_join(f)
    check(f.api.joined.has(ROOM_A),"valid lobby can join BEFORE getLobbyOwner becomes available")
    dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.api.emit_joined(ROOM_A)
    check(f.svc.lobby_id==ROOM_A and f.peers.size()==1,"matching joined lobby starts client transport")
    check(f.peers[0].client_calls[0][0]==f.api.FRIEND_ID,"client targets saved host Steam ID")
    check(f.svc.info().pending,"transport remains pending until actual connection")
    f.svc.mark_connected()
    check(not f.svc.info().pending,"connected handshake clears timeout")
    dispose(f)
    for key in ["game","protocol","host_id"]:
        f=fixture(false)
        room(f)
        f.api.rooms[ROOM_A].data[key]="wrong"
        f.svc.join_room(str(ROOM_A))
        f.api.lobby_data_update.emit(1,ROOM_A,ROOM_A)
        check(f.api.joined.is_empty() and f.signals.failures.size()==1,"incompatible "+key+" rejected before join")
        dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.api.emit_joined(ROOM_A,4)
    check(f.peers.is_empty() and f.svc.lobby_id==0 and f.signals.failures.size()==1,"full lobby callback reports failure without transport")
    dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.api.rooms[ROOM_A].owner=f.api.MY_ID
    f.api.emit_joined(ROOM_A)
    check(f.peers.is_empty() and f.api.left.has(ROOM_A),"owner changes during join are rejected and left")
    dispose(f)
    f=fixture(false)
    f.api.request_ok=false
    check(f.svc.join_room(str(ROOM_A))==ERR_CANT_CONNECT and not f.svc.info().pending,"request metadata rejection clears pending operation")
    dispose(f)
func test_cancel_and_timeout() -> void:
    var f=fixture()
    f.svc.host_room()
    f.svc.leave_room()
    f.api.emit_created(ROOM_A)
    check(f.peers.is_empty() and f.api.left.has(ROOM_A),"cancelled create late callback leaves orphan room")
    check(f.svc.host_room()==OK,"late create completion unblocks future host")
    dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.svc.leave_room()
    f.api.emit_joined(ROOM_A)
    check(f.api.left.has(ROOM_A) and f.peers.is_empty(),"cancelled join late success leaves room")
    dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.svc.leave_room()
    f.svc.host_room()
    f.api.emit_joined(ROOM_A)
    check(f.api.left.has(ROOM_A),"late cancelled join is left even while new create is pending")
    dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.svc.leave_room()
    prepare_join(f,ROOM_B)
    f.api.emit_joined(ROOM_A)
    check(f.api.left.has(ROOM_A) and f.svc._requested_lobby==ROOM_B,"late old join cannot hijack new join")
    f.api.emit_joined(ROOM_B)
    check(f.svc.lobby_id==ROOM_B,"new selected join completes")
    dispose(f)
    f=fixture()
    f.svc.host_room()
    f.svc._process(26)
    check(f.signals.failures.size()==1 and not f.svc.info().pending,"create timeout emits error and clears UI pending")
    check(Texts.resolve(f.svc.status).contains("重启") and not Texts.resolve(f.svc.status).contains("IP"),"create timeout explains restart recovery without removed IP fallback")
    check(f.svc.host_room()==ERR_BUSY and Texts.resolve(f.svc.status).contains("重启"),"native outstanding create remains single flight with explicit recovery")
    var fallback=Session.new()
    root.add_child(fallback)
    fallback.set_physics_process(false)
    fallback.start_solo()
    check(fallback.mode=="offline" and fallback.model.state.players.size()==1,"Steam timeout does not prevent offline play")
    check(fallback.host(32000+randi_range(0,1000))==OK,"Steam timeout does not prevent independent ENet IP host")
    fallback.offline()
    fallback.free()
    f.api.emit_created(ROOM_A)
    check(f.api.left.has(ROOM_A) and f.svc.host_room()==OK,"late native create completion is discarded and unlocks later Steam create")
    dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.svc._process(26)
    f.api.emit_joined(ROOM_A)
    check(f.api.left.has(ROOM_A) and f.peers.is_empty(),"timed out join late callback cannot enter world")
    dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.api.emit_joined(ROOM_A)
    f.svc._process(26)
    check(f.peers[0].closed==1 and f.api.left.has(ROOM_A),"P2P connection timeout closes transport and lobby")
    dispose(f)
func test_identity_and_health() -> void:
    var f=fixture()
    f.svc.host_room()
    f.api.emit_created(ROOM_A)
    f.api.rooms[ROOM_A].members.append(f.api.FRIEND_ID)
    check(f.svc.accept_peer(12),"Steam peer mapped to joined member accepted")
    check(not f.svc.accept_peer(13),"connected socket for outsider rejected")
    check(not f.svc.accept_peer(99),"unknown Steam identity rejected")
    f.api.rooms[ROOM_A].members.erase(f.api.FRIEND_ID)
    check(not f.svc.accept_peer(12),"member removed from room loses authority")
    f.api.rooms[ROOM_A].owner=f.api.FRIEND_ID
    f.svc._check_room()
    check(f.svc.lobby_id==0 and f.peers[0].closed==1 and f.signals.failures.size()==1,"owner migration ends session and closes peer")
    dispose(f)
    f=fixture()
    f.svc.host_room()
    f.api.emit_created(ROOM_A)
    f.api.online=false
    f.svc._process(1.1)
    check(not f.svc.initialized and f.svc.lobby_id==0 and f.api.left.has(ROOM_A),"Steam offline closes room")
    f.api.online=true
    check(f.svc.initialize() and f.api.init_calls==1,"reconnect after Steam online does not reinitialize SDK")
    dispose(f)
func test_social() -> void:
    var f=fixture()
    f.svc.host_room()
    f.api.emit_created(ROOM_A)
    f.svc.invite_friends()
    check(f.api.invites.is_empty() and Texts.resolve(f.svc.status).contains("房间号"),"unavailable overlay provides room code fallback")
    f.api.overlay=true
    f.svc.invite_friends()
    check(f.api.invites==[ROOM_A],"available overlay opens lobby invite")
    f.api.join_requested.emit(ROOM_B,f.api.FRIEND_ID)
    check(f.signals.joins==[str(ROOM_B)],"invite is forwarded with exact lobby code")
    f.api.overlay_toggled.emit(true,true,480)
    check(f.svc.overlay_active and f.signals.overlays==[true],"overlay signals update service")
    dispose(f)
    f=fixture()
    room(f)
    f.api.friends=[f.api.FRIEND_ID]
    f.api.friend_games[f.api.FRIEND_ID]={"id":480,"lobby":ROOM_A}
    f.svc.refresh_friends()
    f.api.lobby_data_update.emit(1,ROOM_A,ROOM_A)
    check(f.svc.lobbies.size()==1,"friend lobby discoverable without membership-dependent owner query")
    dispose(f)
func test_session() -> void:
    var session=Session.new()
    root.add_child(session)
    session.set_physics_process(false)
    var p=FakePeer.new()
    check(session.use_steam_peer(p,true)==ERR_CANT_CONNECT,"session rejects disconnected Steam peer")
    p.create_host(0)
    p.set_server_relay(true)
    var validator=func(id):return id==12
    var names=func(id):return "成员名称"
    check(session.use_steam_peer(p,true,validator,names)==OK,"session accepts connected host Steam peer")
    session._on_peer_connected(13)
    check(not session.model.state.players.has(13) and p.disconnects.size()==1,"session rejects socket failing lobby validator")
    session._on_peer_connected(12)
    check(session.model.state.players.has(12),"session adds accepted member with Godot peer ID")
    session.offline()
    check(p.closed==1 and session.transport=="offline" and session.local_id==1,"session offline closes transport and restores offline player")
    session.free()

func test_extra_failures() -> void:
    var f=fixture()
    f.svc.peer_factory=func():return null
    f.svc.host_room()
    f.api.emit_created(ROOM_A)
    check(f.svc.lobby_id==0 and f.api.left.has(ROOM_A),"null peer factory cleans up newly created lobby")
    dispose(f)
    f=fixture()
    var failed_peer=FakePeer.new()
    failed_peer.create_result=ERR_CANT_CREATE
    f.svc.peer_factory=func():return failed_peer
    f.svc.host_room()
    f.api.emit_created(ROOM_A)
    check(failed_peer.closed==1 and f.svc.peer==null and f.api.left.has(ROOM_A),"P2P host error closes partially opened socket and lobby")
    dispose(f)
    f=fixture(false)
    room(f)
    f.svc.join_room(str(ROOM_A))
    f.svc.leave_room()
    f.api.lobby_data_update.emit(1,ROOM_A,ROOM_A)
    check(f.api.joined.is_empty(),"cancelled metadata request cannot trigger join")
    dispose(f)
    f=fixture(false)
    prepare_join(f)
    f.api.rooms[ROOM_A].data.protocol="different-version"
    f.api.emit_joined(ROOM_A)
    check(f.api.left.has(ROOM_A) and f.peers.is_empty(),"protocol changing between validation and join is rejected")
    dispose(f)
    f=fixture()
    f.svc.initialize()
    f.svc._process(0.1)
    check(f.api.callbacks==1,"manual mode pumps Steam callbacks every process call")
    dispose(f)
    var session=Session.new()
    root.add_child(session)
    session.set_physics_process(false)
    var peer=FakePeer.new()
    peer.create_host(0)
    peer.set_server_relay(true)
    session.use_steam_peer(peer,true,func(id):return true,func(id):return "accepted "+str(id))
    session._on_peer_connected(12)
    session._on_peer_connected(13)
    session._on_peer_connected(14)
    check(session.model.state.players.size()==4,"session accepts three remotes plus host")
    session._on_peer_connected(15)
    check(session.model.state.players.size()==5,"session accepts the fourth remote")
    session._on_peer_connected(16)
    check(session.model.state.players.size()==5 and peer.disconnects[0][0]==16,"sixth session player is disconnected")
    check(session.model.state.players[12].name=="accepted 12","session uses mapped Steam persona provider")
    session.offline()
    var client=FakePeer.new()
    client.create_client(76561198000000002,0)
    client.set_server_relay(true)
    check(session.use_steam_peer(client,false)==OK and session.mode=="client","session accepts connecting Steam client")
    check(session.local_id==0 and session.model.state.players.is_empty(),"client world remains empty until server snapshot")
    session._physics_process(25.1)
    check(session.mode=="offline" and client.closed==1,"session handshake timeout closes client")
    session.free()

func test_cancelled_migration() -> void:
    var mismatch=fixture()
    room(mismatch)
    mismatch.api.rooms[ROOM_A].data.build="older_bunker_build"
    mismatch.svc.join_room(str(ROOM_A))
    mismatch.api.lobby_data_update.emit(1,ROOM_A,ROOM_A)
    check(mismatch.svc._operation.is_empty() and mismatch.svc.lobby_id==0,"different exact build is rejected before native transport")
    dispose(mismatch)
    var f=fixture(false)
    prepare_join(f)
    f.svc.leave_room()
    f.svc.host_room()
    f.api.rooms[ROOM_A].owner=f.api.MY_ID
    f.api.emit_joined(ROOM_A)
    check(f.api.left.has(ROOM_A) and not f.api.in_rooms.has(ROOM_A),"cancelled join cannot leak lobby even if old owner migrates to local user")
    check(f.svc._operation=="create","discarding cancelled migrated lobby preserves active create")
    dispose(f)
