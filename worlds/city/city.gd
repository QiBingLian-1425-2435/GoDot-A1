extends Node3D
signal map_loaded()
## Abandoned city exploration map. Geometry and layout are generated by
## tools/build_city_map.py into assets/worlds/city/ (external art). This node only
## assembles visuals, static collision, air walls and the extraction route.
const ROOT := "res://assets/worlds/city/"
const SHADER = preload("res://worlds/city/city_surface.gdshader")
const KINDS := {"solid":1|8|16, "low":1|8, "post":1|8, "fence":1|8, "roof":1|8|16, "air":1}
var zone := "city"
var build_collisions := true
var loaded := false
var layout: Dictionary = {}
var target_nodes: Dictionary = {}
var _material: ShaderMaterial
var _interactions: Array = []
var _cancelled := false
var _door_nodes: Dictionary = {}
var _door_open: Dictionary = {}

func _ready() -> void:
	layout = read_layout()
	if layout.is_empty(): return
	_material = ShaderMaterial.new()
	_material.shader = SHADER
	var scene: PackedScene = load(ROOT+"city.glb")
	if scene == null:
		push_error("City external asset missing: "+ROOT+"city.glb")
		return
	var source := scene.instantiate()
	add_child(source)
	for mesh in source.find_children("*","MeshInstance3D",true,false):
		mesh.material_override = _material
		# Far tiles stop drawing once well outside the 37 m vision radius + camera frame.
		mesh.visibility_range_end = 0.0
	await get_tree().process_frame
	if _cancelled: return
	_build_ground()
	if build_collisions:
		_build_colliders()
	_build_doors()
	var extraction: Array = layout.extraction
	_interactions.append({"kind":"travel","uid":"city_extraction","world":zone,"title":"⟦city.extraction⟧","pos":Vector2(extraction[0],extraction[2]),"height":float(extraction[1]),"destination":"bunker","spawn":Vector3(-1,0,4)})
	loaded = true
	map_loaded.emit()
	print("CITY_MAP colliders=",layout.colliders.size())

static func read_layout() -> Dictionary:
	var file := FileAccess.open(ROOT+"city_layout.json",FileAccess.READ)
	if file == null:
		push_error("City external asset missing: "+ROOT+"city_layout.json")
		return {}
	var value: Variant = JSON.parse_string(file.get_as_text())
	return value if value is Dictionary else {}

static func spawn_point() -> Vector3:
	var data := read_layout()
	if data.is_empty(): return Vector3.ZERO
	return Vector3(data.spawn[0],data.spawn[1],data.spawn[2])

func play_bounds() -> Rect2:
	var b: Array = layout.get("bounds",[0,-300,300,300])
	return Rect2(b[0],b[1],b[2],b[3])

func cancel_load() -> void:
	_cancelled = true

func _build_ground() -> void:
	if not build_collisions: return
	var body := StaticBody3D.new()
	body.name = "Ground"
	body.collision_layer = 1|4|8|16
	body.collision_mask = 0
	var shape := CollisionShape3D.new()
	var box := BoxShape3D.new()
	box.size = Vector3(700,2,700)
	shape.shape = box
	shape.position = Vector3(140,-1,-140)
	body.add_child(shape)
	add_child(body)

func _build_colliders() -> void:
	# One static body per collision kind keeps thousands of shapes cheap.
	var bodies: Dictionary = {}
	for spec in layout.colliders:
		var kind := str(spec.k)
		if not bodies.has(kind):
			var body := StaticBody3D.new()
			body.name = "City_"+kind
			body.collision_layer = KINDS.get(kind,1|8|16)
			body.collision_mask = 0
			add_child(body)
			bodies[kind] = body
		var shape := CollisionShape3D.new()
		if spec.has("points"):
			var ramp:=ConcavePolygonShape3D.new()
			var points:=PackedVector3Array()
			for point in spec.points:points.append(Vector3(point[0],point[1],point[2]))
			var faces:=PackedVector3Array([points[0],points[4],points[2],points[2],points[4],points[6]])
			ramp.set_faces(faces);ramp.backface_collision=true;shape.shape=ramp
			bodies[kind].add_child(shape)
			continue
		var box := BoxShape3D.new()
		box.size = Vector3(spec.s[0],spec.s[1],spec.s[2])
		shape.shape = box
		shape.position = Vector3(spec.c[0],spec.c[1],spec.c[2])
		shape.rotation.y = float(spec.r)
		bodies[kind].add_child(shape)

func terrain_height(_pos: Vector2) -> float:
	return 0.0

func camera_focus_for(pos: Vector2) -> Vector3:
	return Vector3(pos.x,0,pos.y)

func obstacles() -> Array[Rect2]: return []

func interactions() -> Array:
	return _interactions.duplicate(true)

func set_view_points(player: Vector3, camera: Vector3) -> void:
	if _material == null: return
	_material.set_shader_parameter("view_player",player)
	_material.set_shader_parameter("view_camera",camera)
	_material.set_shader_parameter("view_enabled",true)
	var room := _room_at(player)
	_material.set_shader_parameter("indoor_active",not room.is_empty())
	if not room.is_empty():
		_material.set_shader_parameter("indoor_cut_height",player.y+1.8)
		var bounds: Array = room.bounds
		_material.set_shader_parameter("indoor_bounds",Vector4(bounds[0]-.6,bounds[1]-.6,bounds[0]+bounds[2]+.6,bounds[1]+bounds[3]+.6))

func set_vision(active: bool, parameters: Dictionary) -> void:
	if _material == null: return
	_material.set_shader_parameter("vision_enabled",active)
	for key in parameters:_material.set_shader_parameter(key,parameters[key])

func has_overhead_cover(point: Vector3) -> bool:
	return not _room_at(point).is_empty()

func _room_at(point: Vector3) -> Dictionary:
	for room in layout.get("buildings",[])+layout.get("open_buildings",[]):
		var b: Array = room.bounds
		var roof: float=float(room.get("floors",1))*float(room.get("floor_height",3.0))
		if Rect2(b[0],b[1],b[2],b[3]).has_point(Vector2(point.x,point.z)) and point.y < roof:
			return room
	return {}

func _build_doors() -> void:
	var material := StandardMaterial3D.new()
	material.albedo_color=Color("76543b")
	material.roughness=0.85
	for room in layout.get("buildings",[]):
		var uid: String=room.id
		var at:=Vector3(room.door[0],room.door[1],room.door[2])
		var anchor:=Node3D.new()
		anchor.name=uid;anchor.position=at;anchor.rotation.y=float(room.angle)
		add_child(anchor)
		var body:=StaticBody3D.new()
		body.collision_layer=25 if build_collisions else 0
		body.collision_mask=0
		body.position.x=-float(room.width)/2
		anchor.add_child(body)
		var box:=BoxShape3D.new()
		box.size=Vector3(float(room.width),float(room.height),.16)
		var shape:=CollisionShape3D.new()
		shape.shape=box;shape.position=Vector3(float(room.width)/2,float(room.height)/2,0)
		body.add_child(shape)
		var mesh:=MeshInstance3D.new()
		var geometry:=BoxMesh.new();geometry.size=box.size
		mesh.mesh=geometry;mesh.material_override=material;mesh.position=shape.position
		body.add_child(mesh)
		var handle:=MeshInstance3D.new()
		var handle_mesh:=BoxMesh.new();handle_mesh.size=Vector3(.16,.1,.3)
		handle.mesh=handle_mesh;handle.position=Vector3(float(room.width)-.2,1.0,0)
		body.add_child(handle)
		_door_nodes[uid]={"body":body,"closed":body.transform,"shape":shape,"anchor":at}
		_interactions.append({"kind":"door","uid":uid,"world":zone,"title":"⟦ground_zero.003⟧","pos":Vector2(at.x,at.z),"height":at.y,"initial_open":false})

func update_doors(states: Dictionary) -> void:
	for uid in _door_nodes:
		var opened:=bool(states.get(uid,false))
		if _door_open.has(uid) and _door_open[uid]==opened:continue
		_door_open[uid]=opened
		_door_nodes[uid].body.rotation.y=-PI/2 if opened else 0.0

func can_reach_door(uid: String, from: Vector3) -> bool:
	if not _door_nodes.has(uid):return false
	var part: Dictionary=_door_nodes[uid]
	var excluded: Array[RID]=[part.body.get_rid()]
	var ray:=PhysicsRayQueryParameters3D.create(from+Vector3(0,.8,0),part.anchor+Vector3(0,.8,0),17,excluded)
	return get_world_3d().direct_space_state.intersect_ray(ray).is_empty()

func can_close_door(uid: String) -> bool:
	if not _door_nodes.has(uid):return false
	var part: Dictionary=_door_nodes[uid]
	var query:=PhysicsShapeQueryParameters3D.new()
	query.shape=part.shape.shape
	query.transform=part.body.get_parent().global_transform*part.closed*part.shape.transform
	query.collision_mask=2;query.margin=.04
	return get_world_3d().direct_space_state.intersect_shape(query,1).is_empty()

func vision_targets() -> Array:
	return []

func loot_target(_uid: String) -> Dictionary:
	return {}

func can_reach_loot(_uid: String, _from: Vector3) -> bool:
	return false

func interaction_visuals(target:Dictionary)->Array:
	var uid:String=str(target.get("uid",""))
	if target.get("kind","")=="door" and _door_nodes.has(uid):return [_door_nodes[uid].body]
	return preload("res://features/exploration/interaction_outline.gd").nearby_visuals(self,Vector3(target.pos.x,float(target.get("height",0))+.8,target.pos.y))
